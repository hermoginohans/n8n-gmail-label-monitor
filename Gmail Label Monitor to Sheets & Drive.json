    {
      "parameters": {
        "jsCode": "const emails = $('Extract Sender Info').all().map(i => i.json || {});\nconst labels = $input.all().map(i => i.json || {});\nconst targets = ['Primary', 'Promotions', 'Social'];\nconst map = {};\nfor (const l of labels) { if (l && l.name && targets.includes(l.name)) map[l.name] = l.id; }\nconst out = [];\nfor (const e of emails) {\n  const labelId = map[e.categoryName];\n  if (labelId && e.messageId) {\n    out.push({ json: { messageId: e.messageId, labelId, categoryName: e.categoryName } });\n  }\n}\nreturn out;"
      },
