    {
      "parameters": {
        "jsCode": "const monitored = ($('Config - Labels to Monitor').first().json.categories || []).map(c => String(c).trim().toLowerCase()).filter(Boolean);\nconst q = monitored.map(c => 'category:' + c).join(' OR ');\nreturn [{ json: { q, monitoredMap: {}, categories: monitored } }];"
      },
      "id": "90544856-5e0e-4217-afd0-764748538e71",
      "name": "Build Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "simple": false,
        "filters": {
          "q": "={{ $('Build Query').first().json.q }}",
          "readStatus": "unread"
        },
        "options": {
          "dataPropertyAttachmentsPrefixName": "attachment_",
          "downloadAttachments": true
        }
      },
      "id": "9e8407b5-d0fd-4d37-8e0c-e6dc1d6de92d",
      "name": "Get Unread Emails",
      "credentials": {"gmailOAuth2": {"id": "YOUR_GMAIL_CREDENTIAL_ID", "name": "SELECT: Gmail account whose inbox you want to monitor"}},
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        896,
        96
      ],
      "webhookId": "4b286574-bea3-48fe-bb54-c3b013435ee8"
    },
    {
      "parameters": {
        "jsCode": "const monitoredMap = $('Build Query').first().json.monitoredMap || {};\nconst out = [];\n\nfunction parseFrom(j) {\n  // Non-simple Gmail output: from.value[0].{name,address}\n  if (j.from && Array.isArray(j.from.value) && j.from.value[0]) {\n    return { name: j.from.value[0].name || '', address: j.from.value[0].address || '' };\n  }\n  // Fallbacks: \"From\" string or headers.from -> \"Name <email>\"\n  const raw = j.From || (j.headers && j.headers.from) || (j.from && j.from.text) || '';\n  const m = String(raw).match(/^\\s*\"?([^\"<]*?)\"?\\s*<([^>]+)>/);\n  if (m) return { name: (m[1] || '').trim(), address: (m[2] || '').trim() };\n  return { name: '', address: String(raw).trim() };\n}\n\nfunction sanitize(s) {\n  return String(s || '').replace(/[\\\\/:*?\"<>|]/g, '_').replace(/\\s+/g, ' ').trim().slice(0, 100);\n}\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const f = parseFrom(j);\n  const senderName = sanitize(f.name || f.address || 'Unknown Sender');\n  const senderEmail = f.address || '';\n\n  const ids = Array.isArray(j.labelIds) ? j.labelIds\n    : (Array.isArray(j.labels) ? j.labels.map(l => l.id) : []);\n  let matchedLabel = '';\n  for (const id of ids) { if (monitoredMap[id]) { matchedLabel = monitoredMap[id]; break; } }\n  if (!matchedLabel) matchedLabel = 'Unlabeled';\n\n  let categoryName = 'Primary';\n  if (ids.includes('CATEGORY_PROMOTIONS')) categoryName = 'Promotions';\n  else if (ids.includes('CATEGORY_SOCIAL')) categoryName = 'Social';\n  else categoryName = 'Primary';\n\n  const ms = Number(j.internalDate || j.date || Date.now());\n  const dt = new Date(isNaN(ms) ? Date.now() : ms);\n  const dateReceived = dt.toISOString().slice(0, 10);\n\n  const bin = item.binary || {};\n  const hasAttachments = Object.keys(bin).length > 0;\n\n  out.push({\n    json: {\n      messageId: j.id || j.messageId || '',\n      senderName,\n      senderEmail,\n      subject: j.subject || j.Subject || '',\n      matchedLabel: sanitize(matchedLabel),\n      categoryName,\n      dateReceived,\n      hasAttachments,\n    },\n    binary: item.binary,\n  });\n}\nreturn out;"
      },
